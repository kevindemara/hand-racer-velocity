{
  "name": "hand-racer-velocity",
  "version": "1.0.0",
  "description": "3D arcade racing with calibrated webcam controls and authoritative multiplayer",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build": "node scripts/prepare-worker.mjs && vite build",
    "build:worker": "node scripts/prepare-worker.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs"
  },
  "keywords": [
    "threejs",
    "multiplayer",
    "socket.io",
    "gesture",
    "mediapipe",
    "game"
  ],
  "author": "Eventide Studios",
  "license": "MIT",
  "dependencies": {
    "express": "5.2.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "@mediapipe/tasks-vision": "1.1.0"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
